{
    "name": "youvision/think-pscws4",
    "description": "PSCWS4 纯 PHP 中文分词，适配 ThinkPHP 8",
    "type": "library",
    "keywords": [
        "thinkphp",
        "pscws4",
        "scws",
        "segment",
        "chinese"
    ],
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkPscws4\\": "src/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkPscws4\\Service"
            ]
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}